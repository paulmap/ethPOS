# Copy to /etc/ethpos-assistant.env on the VPS and fill in real values.
# Referenced by the systemd unit via EnvironmentFile=.

PORT=8080
API_KEY=replace-with-the-key-generated-in-app-settings
OLLAMA_URL=http://localhost:11434
MODEL_NAME=qwen2.5:3b-instruct
CATALOG_PATH=/var/lib/ethpos-assistant/catalog.json
